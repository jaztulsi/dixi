{
  "name": "dixi",
  "productName": "Dixi",
  "version": "1.0.0",
  "description": "Dixi: a hands-free, voice-powered browser (Electron).",
  "type": "module",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/gate.js test/unit/*.test.js",
    "test:e2e": "playwright test",
    "live": "node eval/live.js",
    "demo": "node eval/demo.js",
    "eval": "node eval/run.js",
    "stt": "node eval/audio.js",
    "refresh-apple-catalog": "node scripts/refresh-apple-catalog.js",
    "refresh-blocklist": "node scripts/refresh-blocklist.js",
    "refresh-unsafe": "node scripts/refresh-unsafe.js",
    "bench": "node --import ./test/no-network.js eval/bench.js",
    "build:ear": "cd native/dixi-ear && swift build -c release",
    "smoke": "node eval/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "dotenv": "18.0.8",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.7.2"
  }
}
