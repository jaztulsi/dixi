# Copy this file to .env (same folder) and paste your keys after the = signs.
# .env is gitignored, so your keys never get committed. Only Dixi's main process reads them.

# The AI. Hybrid (the default) needs both: Cerebras for the fast, frequent calls, Claude for planning
# shopping commands, checks that failed, and cart verification.
# https://cloud.cerebras.ai  ->  API keys
CEREBRAS_API_KEY=
# https://console.anthropic.com  ->  API keys
ANTHROPIC_API_KEY=
# Only for a key that isn't scoped to a workspace.
# ANTHROPIC_WORKSPACE_ID=

# hybrid | cerebras | claude  (cerebras or claude = that provider only, to compare speed and accuracy)
# DIXI_MODE=hybrid
# When a fast answer is handed to Claude (JSON; defaults shown):
# DIXI_ESCALATE={"schemaFail":true,"validationFail":true,"lowConfidence":0.6,"failuresBeforeEscalate":2,"unexpectedPage":true,"sensitive":true,"finalCartCheck":true}

# Spend caps in USD: overall, and per provider.
# DIXI_SPEND_CAP=25
# DIXI_CAP_CEREBRAS=
# DIXI_CAP_ANTHROPIC=

# Voice. ElevenLabs is used when its key is set, else Deepgram.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# https://console.deepgram.com  (role: Member)
DEEPGRAM_API_KEY=

# Optional: Groq as an extra provider (use it through a tier override, e.g. DIXI_FAST=groq:qwen/qwen3.8-27b).
# GROQ_API_KEY=
