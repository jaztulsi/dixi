# Copy this file to .env (same folder) and paste your keys after the = signs.
# .env is gitignored, so your keys never get committed. Rebuild after editing.

# https://console.groq.com/keys
GROQ_API_KEY=

# https://console.deepgram.com  (role: Member). Only needed for voice.
DEEPGRAM_API_KEY=

# Optional: override the Groq models (see https://console.groq.com/docs/models)
# AGENT_MODEL=qwen/qwen3.8-27b
# VOICE_MODEL=openai/gpt-oss-20b
