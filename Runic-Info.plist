<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Merged with the generated Info.plist. Registers runic:// so the website's
     "Launch Runic" button can open the app. Kept outside Runic/ so the synced
     folder doesn't also copy it into the bundle as a resource. -->
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.oc7.runic</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>runic</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
