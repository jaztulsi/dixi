# Copy to .env.local (same folder). On Vercel, add both under Project -> Settings -> Environment Variables.
# Supabase -> Project Settings -> API: the project URL and the publishable (or legacy anon) key.
# Both are public by design; supabase/waitlist.sql makes the key insert-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
# The admin user's email (Supabase -> Authentication -> Users). /admin asks only for its password.
NEXT_PUBLIC_ADMIN_EMAIL=
